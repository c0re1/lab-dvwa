{
  // Ubuntu 24.04 fijado: en "ubuntu" (26.04) docker-in-docker aún no instala.
  "name": "TS Cyber Academy · DVWA",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  // Máquina mínima (2 núcleos) para gastar la menor cuota posible.
  "hostRequirements": { "cpus": 2 },
  "postStartCommand": "bash .devcontainer/start.sh",
  "forwardPorts": [4280],
  "portsAttributes": {
    "4280": { "label": "DVWA", "onAutoForward": "openBrowser" }
  },
  "customizations": {
    "codespaces": { "openFiles": ["README.md"] }
  }
}
